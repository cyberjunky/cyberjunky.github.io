---
layout: none
---
[
  {% for post in site.posts %}
  {
    "title":    {{ post.title    | jsonify }},
    "url":      {{ post.url      | relative_url | jsonify }},
    "date":     {{ post.date     | date: "%-d %b %Y" | jsonify }},
    "category": {{ post.category | default: "" | jsonify }},
    "tags":     {{ post.tags     | join: " " | jsonify }},
    "excerpt":  {{ post.excerpt  | strip_html | normalize_whitespace | truncate: 300 | jsonify }},
    "content":  {{ post.content  | strip_html | normalize_whitespace | truncate: 2000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
